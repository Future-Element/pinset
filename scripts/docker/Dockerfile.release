FROM rust:1.97.1-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
CMD ["cargo", "build", "--release", "--locked", "-p", "pinset-cli", "-p", "pinset-shim"]
