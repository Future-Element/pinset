{
  "name": "pinset-vscode",
  "displayName": "Pinset",
  "description": "Pinset 3 toolchain status, installation, SDK and JDK bindings, and explicit execution probes.",
  "version": "3.0.1",
  "publisher": "FutureElement",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Future-Element/pinset.git"
  },
  "homepage": "https://pinset.future-element.com/",
  "bugs": {
    "url": "https://github.com/Future-Element/pinset/issues"
  },
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pinset",
    "toolchain",
    "openjdk"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "No CLI or tool process is started before Workspace Trust is granted."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.pinset/config.toml",
    "onCommand:pinset.refresh",
    "onCommand:pinset.install",
    "onCommand:pinset.check",
    "onCommand:pinset.probe",
    "onCommand:pinset.bind"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pinset.refresh",
        "title": "Pinset: Refresh Status"
      },
      {
        "command": "pinset.install",
        "title": "Pinset: Install Locked Toolchains"
      },
      {
        "command": "pinset.check",
        "title": "Pinset: Check Project"
      },
      {
        "command": "pinset.probe",
        "title": "Pinset: Run Explicit Probes"
      },
      {
        "command": "pinset.bind",
        "title": "Pinset: Bind Project SDKs and JDK"
      }
    ],
    "configuration": {
      "title": "Pinset",
      "properties": {
        "pinset.executable": {
          "type": "string",
          "default": "pinset",
          "description": "Path to the Pinset 3 CLI executable."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --main-fields=module,main --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "npm run compile && vsce package --no-dependencies --out dist/pinset-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "extensionKind": [
    "workspace"
  ],
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
