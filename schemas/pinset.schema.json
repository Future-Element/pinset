{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Future-Element/pinset/main/schemas/pinset.schema.json",
  "title": "Pinset project configuration",
  "description": "Schema for pinset.toml. Associate it with TOML files through a VS Code TOML extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project-id", "tools"],
  "properties": {
    "schema": { "const": 5 },
    "project-id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit-global": { "type": "boolean", "default": false },
        "system-fallback": { "type": "boolean", "default": false },
        "boundary": { "enum": ["git", "filesystem"], "default": "git" },
        "verification-strength": {
          "enum": ["checksum", "signed-checksum", "provenance"]
        },
        "minimum-release-age": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[dhms]$"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": { "$ref": "#/$defs/selector" },
        "pnpm": { "$ref": "#/$defs/selector" },
        "bun": { "$ref": "#/$defs/selector" },
        "go": { "$ref": "#/$defs/selector" },
        "flutter": { "$ref": "#/$defs/selector" },
        "python": { "$ref": "#/$defs/selector" },
        "java": { "$ref": "#/$defs/selector" },
        "rust": { "$ref": "#/$defs/selector" },
        "dotnet": { "$ref": "#/$defs/selector" }
      }
    },
    "tool-options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": { "enum": ["minimal", "default", "complete"] },
            "components": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "targets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distribution": { "const": "temurin" },
            "package": { "enum": ["jdk", "jre"] }
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/taskName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "depends-on": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/taskName" }
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }
          },
          "profile": { "$ref": "#/$defs/profileName" },
          "description": { "type": "string" },
          "python-environment": { "$ref": "#/$defs/pythonEnvironmentName" }
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environments": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              { "$ref": "#/$defs/pythonEnvironmentName" },
              { "not": { "const": "default" } }
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }
              }
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![./])(?!.*/(?:\\.|\\.\\.)(?:/|$))[^\\\\:]+$"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto-profile": { "$ref": "#/$defs/profileName" },
        "collision": {
          "enum": ["error", "process-wins", "encrypted-wins"],
          "default": "error"
        },
        "profiles": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/profileName" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "recipients"],
            "properties": {
              "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "recipients": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^age1" }
              }
            }
          }
        },
        "variables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(?!PATH$)(?!PINSET_)[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": ["string", "integer", "boolean", "url", "enum"],
                "default": "string"
              },
              "required": { "type": "boolean", "default": false },
              "secret": { "type": "boolean", "default": false },
              "default": { "type": "string" },
              "profiles": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/profileName" }
              },
              "values": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string" }
              },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "selector": { "type": "string", "minLength": 1 },
    "profileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "taskName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "pythonEnvironmentName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
